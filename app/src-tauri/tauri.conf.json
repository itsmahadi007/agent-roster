{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Agent Roster",
  "identifier": "com.mahadihassan.agentroster",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Agent Roster",
        "width": 1200,
        "height": 660,
        "minWidth": 1000,
        "minHeight": 560,
        "backgroundColor": "#111925"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Name your AI coding accounts",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDdBQTQwRTQxRTEwREYyNDQKUldSRThnM2hRUTZrZXV6cHU0WlpwVWk4YmkxUHJzTEJWN0x0eE11OGw0UEFvNjQ5UW9oQnZGaVUK",
      "endpoints": [
        "https://github.com/itsmahadi007/agent-roster/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
